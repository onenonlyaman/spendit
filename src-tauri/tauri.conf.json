{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SpendIt",
  "version": "1.0.7",
  "identifier": "com.spendit.desktop",




  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:3000",
    "beforeDevCommand": "npm run client",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SpendIt — Personal Financial Diary",
        "width": 1280,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": "v1Compatible",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },

  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQwODVCNkJEQzZCRjAzNDkKUldSSkE3L0d2YmFGMEJBd0g4aVU0eDNrRWp5QmR5QThmYlY0OTNEK2IvRUZkWVd4WDhtelRLa0UK",
      "endpoints": [
        "https://github.com/onenonlyaman/spendit/releases/latest/download/latest.json"
      ]
    }
  }
}



